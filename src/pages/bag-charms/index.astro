---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BagCharmCard from '../../components/BagCharmCard.astro';
import { getCollection } from 'astro:content';

const allBagCharms = await getCollection('bagCharms');

// Featured first, then alphabetical.
const sorted = [...allBagCharms].sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return a.data.title.localeCompare(b.data.title);
});

// CollectionPage/ItemList structured data (JSON-LD) for the bag charm collection.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Bag Charm Pattern Collection',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: sorted.map((charm, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/bag-charms/${charm.slug}`, Astro.site).toString(),
      name: charm.data.title,
    })),
  },
};
---

<BaseLayout
  title="Bag Charm Pattern Collection"
  description="PDF crochet patterns for bag charms — small, detailed makes to clip onto a bag or keychain."
  structuredData={structuredData}
>

  <!-- PAGE HEADER -->
  <section class="page-header">
    <div class="container">
      <p class="page-eyebrow">The Collection</p>
      <h1 class="page-title">Bag charm patterns for small, satisfying makes</h1>
      <p class="page-desc">
        Each pattern is a small, detailed charm — quick enough for an evening or
        two, with the same step-by-step photos and clear instructions as the
        quiet books. Download the PDF, gather your yarn, and make something to
        clip onto a bag or keychain.
      </p>
    </div>
  </section>


  <!-- BAG CHARM GRID -->
  <section class="patterns-section">
    <div class="container">
      <div class="pattern-grid">
        {sorted.map(charm => (
          <BagCharmCard
            title={charm.data.title}
            tagline={charm.data.tagline}
            slug={charm.slug}
            coverImage={charm.data.coverImage}
            etsy_url={charm.data.etsy_url}
          />
        ))}
      </div>
    </div>
  </section>


  <!-- ETSY CTA STRIP -->
  <section class="etsy-strip" aria-label="Shop on Etsy">
    <div class="container etsy-strip-inner">
      <p>All patterns are PDF instant downloads, available on Etsy.</p>
      <a
        href="https://www.etsy.com/shop/artbygng"
        class="btn btn-accent"
        target="_blank"
        rel="noopener noreferrer"
      >
        Visit the Artbygng Etsy shop &nearr;
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ----- PAGE HEADER ----- */
  .page-header {
    padding-block: var(--space-20) var(--space-12);
    text-align: center;
    background: var(--cream-alt);
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .page-header { padding-block: var(--space-12) var(--space-8); }
  }

  .page-eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-3);
    max-width: none;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    max-width: 22ch;
    margin-inline: auto;
    margin-bottom: var(--space-5);
  }

  .page-desc {
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.72;
    max-width: 54ch;
    margin-inline: auto;
  }


  /* ----- GRID ----- */
  .patterns-section {
    padding-block: var(--space-16);
  }

  .pattern-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 580px) {
    .pattern-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 960px) {
    .pattern-grid { grid-template-columns: repeat(3, 1fr); }
  }


  /* ----- ETSY STRIP ----- */
  .etsy-strip {
    background: var(--ink);
    padding-block: var(--space-12);
  }

  .etsy-strip-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .etsy-strip-inner p {
    color: rgba(250, 248, 244, 0.8);
    font-size: 1.05rem;
    max-width: none;
  }

  @media (min-width: 640px) {
    .etsy-strip-inner {
      flex-direction: row;
      justify-content: center;
      gap: var(--space-8);
      text-align: left;
    }
  }
</style>
