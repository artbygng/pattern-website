---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allFreePatterns = await getCollection('freePatterns');
  return allFreePatterns.map(pattern => ({
    params: { slug: pattern.slug },
    props: { pattern },
  }));
}

const { pattern } = Astro.props;
const { Content } = await pattern.render();
const { title, description, coverImage } = pattern.data;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: title,
  description,
  image: new URL(coverImage, Astro.site).toString(),
  isAccessibleForFree: true,
  url: canonicalUrl.toString(),
};
---

<BaseLayout
  title={title}
  description={description}
  ogImage={coverImage}
  structuredData={structuredData}
>

  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <a href="/free-patterns" class="back-link">&larr; All free patterns</a>
    </div>
  </div>

  <!-- PATTERN HEADER -->
  <section class="post-header section-padding">
    <div class="container post-header-inner">
      <p class="post-eyebrow">Free Pattern</p>
      <h1 class="post-title">{title}</h1>
      <p class="post-desc">{description}</p>
    </div>
  </section>

  <div class="post-cover container">
    <img src={coverImage} alt={`${title} — free crochet pattern cover`} width="1200" height="1200" loading="eager" />
  </div>

  <!-- Markdown content -->
  <section class="post-body section-padding">
    <div class="container">
      <div class="post-content prose">
        <Content />
      </div>
    </div>
  </section>

  <!-- CTA strip -->
  <section class="cta-strip">
    <div class="container cta-strip-inner">
      <div class="cta-strip-text">
        <p class="cta-eyebrow">Want a bigger project?</p>
        <p class="cta-sub">Browse the full crochet quiet book pattern collection.</p>
      </div>
      <a href="/patterns" class="btn btn-accent btn-lg">
        Browse patterns &rarr;
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- BREADCRUMB ---- */
  .breadcrumb-bar {
    background: var(--cream-alt);
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-3);
  }

  .back-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .back-link:hover { color: var(--ink); }

  /* ---- PATTERN HEADER ---- */
  .post-header {
    background: var(--cream-alt);
    padding-bottom: var(--space-10);
  }

  .post-header-inner {
    max-width: 72ch;
    margin-inline: auto;
  }

  .post-eyebrow {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .post-title {
    font-size: clamp(1.9rem, 4.5vw, 3rem);
    margin-bottom: var(--space-4);
  }

  .post-desc {
    color: var(--ink-muted);
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: none;
    margin-bottom: 0;
  }

  /* ---- COVER IMAGE ---- */
  .post-cover {
    margin-top: calc(-1 * var(--space-8));
    max-width: 480px;
    margin-inline: 0;
  }

  .post-cover img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-lg);
    display: block;
  }

  /* ---- BODY (prose) ---- */
  .post-content {
    max-width: 72ch;
    margin-inline: auto;
  }

  .prose :global(h2) {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.5vw, 2rem);
    font-weight: 500;
    color: var(--ink);
    margin-top: var(--space-10);
    margin-bottom: var(--space-5);
  }

  .prose :global(h2:first-child) { margin-top: 0; }

  .prose :global(p) {
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: var(--space-4);
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(a) {
    color: var(--accent);
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin-block: var(--space-6);
  }

  .prose :global(ul) {
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.8;
    padding-left: 1.4em;
    margin-bottom: var(--space-4);
    list-style: disc;
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  /* ---- CTA STRIP ---- */
  .cta-strip {
    background: var(--ink);
    padding-block: var(--space-12);
  }

  .cta-strip-inner {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
    justify-content: space-between;
  }

  .cta-eyebrow {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 500;
    color: var(--white);
    margin-bottom: var(--space-2);
    max-width: none;
  }

  .cta-sub {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: none;
    margin-bottom: 0;
  }
</style>
