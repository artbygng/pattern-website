---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allFreePatterns = await getCollection('freePatterns');
const sorted = [...allFreePatterns].sort((a, b) => a.data.title.localeCompare(b.data.title));

// CollectionPage/ItemList structured data (JSON-LD) for the free pattern collection.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Free Crochet Patterns',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: sorted.map((pattern, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/free-patterns/${pattern.slug}`, Astro.site).toString(),
      name: pattern.data.title,
    })),
  },
};
---

<BaseLayout
  title="Free Crochet Patterns"
  description="Free crochet patterns from Artbygng — small amigurumi makes, no purchase required."
  structuredData={structuredData}
>

  <!-- PAGE HEADER -->
  <section class="page-header">
    <div class="container">
      <p class="page-eyebrow">Free Patterns</p>
      <h1 class="page-title">A few free patterns to enjoy</h1>
      <p class="page-desc">
        Small, quick makes — no purchase required.
      </p>
    </div>
  </section>

  <!-- FREE PATTERN GRID -->
  <section class="patterns-section">
    <div class="container">
      <div class="pattern-grid">
        {sorted.map(pattern => (
          <a href={`/free-patterns/${pattern.slug}`} class="free-pattern-card">
            <div class="card-img">
              <img src={pattern.data.coverImage} alt={`${pattern.data.title} — free crochet pattern cover`} width="600" height="800" loading="lazy" class="card-cover-img" />
            </div>
            <div class="card-body">
              <h2 class="card-title">{pattern.data.title}</h2>
              <p class="card-desc">{pattern.data.description}</p>
              <span class="card-link">View the pattern &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ----- PAGE HEADER ----- */
  .page-header {
    padding-block: var(--space-20) var(--space-12);
    text-align: center;
    background: var(--cream-alt);
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .page-header { padding-block: var(--space-12) var(--space-8); }
  }

  .page-eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-3);
    max-width: none;
  }

  .page-title {
    font-size: clamp(2rem, 5vw, 3.25rem);
    max-width: 22ch;
    margin-inline: auto;
    margin-bottom: var(--space-5);
  }

  .page-desc {
    color: var(--ink-muted);
    font-size: 1.05rem;
    line-height: 1.72;
    max-width: 54ch;
    margin-inline: auto;
  }

  /* ----- GRID ----- */
  .patterns-section {
    padding-block: var(--space-16);
  }

  .pattern-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 580px) {
    .pattern-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 960px) {
    .pattern-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ----- CARD ----- */
  .free-pattern-card {
    background: var(--cream);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s;
  }

  .free-pattern-card:hover {
    box-shadow: 0 10px 28px rgba(42, 40, 37, 0.09);
  }

  .card-img {
    aspect-ratio: 10 / 11;
    overflow: hidden;
    background: var(--cream-alt);
  }

  .card-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--ink-muted);
    line-height: 1.55;
    flex: 1;
    max-width: none;
  }

  .card-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
  }
</style>
